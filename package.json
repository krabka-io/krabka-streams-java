{
  "name": "krabka-streams-java-docs-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Markdown formatting and linting tools for krabka-streams-java",
  "license": "Apache-2.0",
  "scripts": {
    "format:markdown": "prettier --write \"**/*.md\"",
    "checkFormat:markdown": "prettier --check \"**/*.md\"",
    "lint:markdown": "markdownlint-cli2"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.23.2",
    "prettier": "3.9.6"
  }
}
