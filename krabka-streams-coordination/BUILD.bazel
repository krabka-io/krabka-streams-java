load("@rules_java//java:defs.bzl", "java_library", "java_test")

java_library(
    name = "krabka-streams-coordination",
    srcs = glob(["src/main/java/**/*.java"]),
    javacopts = ["--release", "17", "-parameters"],
    visibility = ["//visibility:public"],
    deps = ["//krabka-streams"],
    exports = ["//krabka-streams"],
)

java_test(
    name = "tests",
    srcs = glob(["src/test/java/**/*.java"]),
    args = ["execute", "--select-package=io.krabka.streams.coordination", "--fail-if-no-tests"],
    javacopts = ["--release", "17", "-parameters"],
    main_class = "org.junit.platform.console.ConsoleLauncher",
    use_testrunner = False,
    deps = [
        ":krabka-streams-coordination",
        "@krabka_streams_maven//:com_google_testparameterinjector_test_parameter_injector_junit5",
        "@krabka_streams_maven//:org_assertj_assertj_core",
        "@krabka_streams_maven//:org_junit_platform_junit_platform_console_standalone",
    ],
)

filegroup(
    name = "main_srcs",
    srcs = glob(["src/main/java/**/*.java"]),
    visibility = ["//:__pkg__"],
)
